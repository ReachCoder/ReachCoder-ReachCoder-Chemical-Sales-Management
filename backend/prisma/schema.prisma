generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model audit_logs {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt?
  action     String   @db.VarChar(100)
  entity     String   @db.VarChar(100)
  entity_id  BigInt?
  details    Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_audit_logs_user")

  @@index([created_at], map: "idx_audit_logs_created_at")
}

model customers {
  id                     BigInt                   @id @default(autoincrement())
  name                   String                   @db.VarChar(150)
  phone                  String?                  @db.VarChar(30)
  email                  String?                  @db.VarChar(150)
  address                String?
  telegram_chat_id       String?                  @unique @db.VarChar(100)
  note                   String?
  is_active Boolean  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  sales                  sales[]
  telegram_notifications telegram_notifications[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id                     BigInt                   @id @default(autoincrement())
  sale_id                BigInt
  user_id                BigInt
  amount_paid            Decimal                  @db.Decimal(12, 2)
  payment_method         String                   @default("CASH") @db.VarChar(30)
  payment_date           DateTime                 @default(now()) @db.Timestamptz(6)
  note                   String?
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  sales                  sales                    @relation(fields: [sale_id], references: [id], onUpdate: NoAction, map: "fk_payments_sale")
  users                  users                    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_payments_user")
  telegram_notifications telegram_notifications[]

  @@index([payment_date], map: "idx_payments_payment_date")
  @@index([sale_id], map: "idx_payments_sale_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id              BigInt            @id @default(autoincrement())
  name            String            @db.VarChar(200)
  sku             String?           @unique @db.VarChar(50)
  description     String?
  price           Decimal           @default(0) @db.Decimal(12, 2)
  stock_quantity  Int               @default(0)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  sale_items      sale_items[]
  stock_movements stock_movements[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sale_items {
  id                    BigInt   @id @default(autoincrement())
  sale_id               BigInt
  product_id            BigInt
  product_name_snapshot String   @db.VarChar(200)
  quantity              Int
  unit_price            Decimal  @db.Decimal(12, 2)
  subtotal Decimal? @default(dbgenerated("(quantity::numeric * unit_price)")) @db.Decimal(12, 2)
  products              products @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "fk_sale_items_product")
  sales                 sales    @relation(fields: [sale_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sale_items_sale")

  @@index([sale_id], map: "idx_sale_items_sale_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sales {
  id                     BigInt                   @id @default(autoincrement())
  sale_number            String                   @unique @db.VarChar(50)
  customer_id            BigInt
  user_id                BigInt
  total_amount           Decimal                  @default(0) @db.Decimal(12, 2)
  sale_date              DateTime                 @default(now()) @db.Timestamptz(6)
  note                   String?
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  payments               payments[]
  sale_items             sale_items[]
  customers              customers                @relation(fields: [customer_id], references: [id], onUpdate: NoAction, map: "fk_sales_customer")
  users                  users                    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_sales_user")
  telegram_notifications telegram_notifications[]

  @@index([customer_id], map: "idx_sales_customer_id")
  @@index([sale_date], map: "idx_sales_sale_date")
  @@index([user_id], map: "idx_sales_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model telegram_notifications {
  id            BigInt     @id @default(autoincrement())
  customer_id   BigInt?
  sale_id       BigInt?
  payment_id    BigInt?
  chat_id       String?    @db.VarChar(100)
  message       String
  status        String     @default("PENDING") @db.VarChar(20)
  sent_at       DateTime?  @db.Timestamptz(6)
  error_message String?
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  customers     customers? @relation(fields: [customer_id], references: [id], onUpdate: NoAction, map: "fk_notifications_customer")
  payments      payments?  @relation(fields: [payment_id], references: [id], onUpdate: NoAction, map: "fk_notifications_payment")
  sales         sales?     @relation(fields: [sale_id], references: [id], onUpdate: NoAction, map: "fk_notifications_sale")

  @@index([status], map: "idx_notifications_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id              BigInt            @id @default(autoincrement())
  username        String            @unique @db.VarChar(100)
  password_hash   String
  full_name       String            @db.VarChar(150)
  role             String            @default("STAFF") @db.VarChar(20)
  is_active        Boolean           @default(true)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @default(now()) @db.Timestamptz(6)
  audit_logs       audit_logs[]
  payments         payments[]
  sales            sales[]
  stock_movements  stock_movements[]
}



model stock_movements {
  id            BigInt   @id @default(autoincrement())
  product_id    BigInt
  user_id       BigInt
  movement_type String   @db.VarChar(10)
  quantity      Int
  stock_before  Int
  stock_after   Int
  note          String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  products products @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "fk_stock_movements_product")
  users    users    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_stock_movements_user")

  @@index([product_id], map: "idx_stock_movements_product_id")
  @@index([user_id], map: "idx_stock_movements_user_id")
  @@index([created_at], map: "idx_stock_movements_created_at")
  @@index([movement_type], map: "idx_stock_movements_type")
}

